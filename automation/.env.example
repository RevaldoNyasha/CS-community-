# Copy to `.env` for local runs:  node --env-file=.env src/index.js
# In CI these come from GitHub Secrets — never commit the real .env.

# --- Google Gemini (free tier) — https://aistudio.google.com/app/apikey ---
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash — stable + free-tier friendly).
# Avoid gemini-flash-latest (overloaded/429-prone) and gemini-2.0-flash (0 free quota
# on some keys). gemini-2.5-flash-lite is a lighter option with higher rate limits.
GEMINI_MODEL=gemini-2.5-flash

# --- Laravel ingestion API ---
# Base URL, no trailing slash. Prod: https://www.cs-community.space
LARAVEL_API_URL=https://www.cs-community.space
# Must equal AUTOMATION_API_TOKEN in the Laravel .env
LARAVEL_API_TOKEN=

# --- Optional ---
# Raises the GitHub Search API rate limit (the Action auto-provides one)
GITHUB_TOKEN=
# Max items processed per run (Gemini free-tier safety). Default: 15
MAX_ITEMS=15
# Pause between Gemini calls in ms to respect free-tier RPM (~15/min). Default: 4000
GEMINI_DELAY_MS=4000

# --- Editorial focus (all optional; sensible defaults baked into src/config.js) ---
# Min focus-keyword score to keep an item (0 = rank only, no filtering). Default: 1
MIN_RELEVANCE=1
# Comma-separated overrides — leave blank to use the defaults in src/config.js
FOCUS_KEYWORDS=
REDDIT_SUBREDDITS=
# Only surface OpenRouter models created within this many days. Default: 45
OPENROUTER_DAYS=45
# Override the RSS blog list (JSON array of {name,url,category}); blank = defaults
FEEDS=
# Set to 1 to log payloads without publishing
DRY_RUN=0
